# TaskFlow Pro API
# Разрешаем все запросы

Options -Indexes

## mod_security
##
## Не отключайте mod_security в production без крайней необходимости.
## Если возникают ложные срабатывания, лучше настроить правила/исключения точечно.
# <IfModule mod_security2.c>
#     SecRuleEngine Off
# </IfModule>

# Разрешаем доступ
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

<FilesMatch "^config\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    RewriteRule ^logs(?:/|$) - [F,L]

    # Передаем Authorization заголовок в PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Пропускаем существующие файлы
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Все запросы на index.php
    RewriteRule ^(.*)$ index.php?endpoint=$1 [L,QSA]
</IfModule>

## CORS
##
## По умолчанию CORS не включаем.
## Важно: комбинация Allow-Origin "*" + Allow-Credentials "true" некорректна для браузеров.
## Если UI и API на одном домене, CORS не нужен.
## Если UI/API на разных доменах, включайте CORS allowlist на уровне reverse proxy (nginx)
## или выставляйте конкретный Origin вместо "*".

# MIME
<IfModule mod_mime.c>
    AddType application/json json
</IfModule>
