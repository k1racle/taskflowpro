Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:backups|docs|instructions|tools|migrations|vendor|old|plans|integrations|runtime|\.github)(?:/|$) - [F,L]
</IfModule>

<FilesMatch "^(config\.php|docker-entrypoint\.sh|Dockerfile|portainer-stack\.yml|\.dockerignore|\.gitattributes)$">
    Require all denied
</FilesMatch>
